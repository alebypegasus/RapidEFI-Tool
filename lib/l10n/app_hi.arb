  "bootArgWatchdog0": "बूट डिबगिंग के दौरान आकस्मिक पैनिक-ट्रिगर पुनरारंभ को रोकने के लिए वॉचडॉग को अक्षम करें।",
  "bootArgSlide0": "शुरुआती बूट कर्नेल पैनिक के कारण होने वाले मेमोरी विरोध को ठीक करने के लिए KASLR को अक्षम करें। डिबगिंग के लिए उपयोग किया जाता है।",
  "bootArgNoCompatCheck": "निषिद्ध प्रतीक से बचने के लिए बूट के दौरान मॉडल संगतता जांच छोड़ें। नोट: इंस्टॉलर मॉडल जांच को बायपास नहीं करता है।",
  "bootArgCpus1": "केवल 1 सीपीयू कोर सक्षम करें (प्रारंभिक इंस्टॉलेशन डिबगिंग के दौरान कर्नेल पैनिक समस्याओं वाले X58/X79/X99/X299 मल्टी-कोर सर्वर सीपीयू के लिए)।",
  "bootArgBetaFix": "उन समस्याओं को ठीक करें जो नवीनतम macOS (मुख्य रूप से बीटा) में दिखाई दे सकती हैं, जैसे ऑडियो, ब्लूटूथ, सीपीयू आवृत्ति विसंगतियाँ। बीटा संस्करणों पर पुरजोर अनुशंसा की गई।",
  "bootArgAmfi0x80": "नए GPU (HD4000+, GT710+ केप्लर) के लिए या वाई-फ़ाई ड्राइवरों को पैच करते समय AMFI अक्षम करें। Amfi_get_out_of_my_way=0x1 के साथ प्रयोग न करें। केवल एसआईपी अक्षम होने पर प्रभावी।",
  "bootArgAmfiGetOut": "पुराने GPU (उदाहरण के लिए, GT240) या वाई-फाई ड्राइवरों को पैच करते समय AMFI को अक्षम करें। Amfi=0x80 के साथ प्रयोग न करें। केवल एसआईपी अक्षम होने पर प्रभावी।",
  "bootArgIpcControl": "AMFI को अक्षम करने के बाद ऐप क्रैश (उदाहरण के लिए, Baidu नेटडिस्क) को ठीक करें। केवल एसआईपी अक्षम होने पर प्रभावी।",
  "bootArgAmfiPassBeta": "सुनिश्चित करें कि AMFI सुरक्षा जांच को बायपास करना जारी रखने के लिए AMFIPass.kext नवीनतम macOS Tahoe 26 में काम करता है।",
  "bootArgRevpatch": "SIP या सिक्योरबूटमॉडल को अक्षम करने के बाद macOS OTA अपडेट समस्याओं को ठीक करें, और कस्टम CPU नाम डिस्प्ले को ठीक करें।",
  "bootArgDisableGfxFirmware": "फ़र्मवेयर लोड विफलता (केवल Intel iGPU) के कारण स्टार्टअप के दौरान हैंग होने से बचने के लिए Apple ग्राफ़िक्स फ़र्मवेयर लोडिंग को अक्षम करें।",
  "bootArgWegNoIgpu": "Intel iGPU को अक्षम करें (अनुशंसित जब iGPU चलाया नहीं जा सकता या हार्डवेयर त्वरण का समर्थन नहीं करता)।",
  "bootArgIgfxVesa": "Intel iGPU एक्सेलेरेशन को अक्षम करें (जब OCLP iGPU पैच लगाने के बाद सिस्टम प्रारंभ न हो तो इसका उपयोग करें, केवल डीबग करें)।",
  "bootArgIgfxRpsc": "Intel iGPU प्रदर्शन को ठीक करें और सुधारें (उदाहरण के लिए, 4K HEVC एन्कोडिंग, रिज़ॉल्यूशन और FPS समस्याओं को ठीक करें)।",
  "bootArgIgfxMpc": "अधिकतम पिक्सेल क्लॉक ओवरराइड को बाध्य करके, macOS डिफ़ॉल्ट रिज़ॉल्यूशन/रीफ्रेश दर सीमाओं को हटाकर iGPU रिज़ॉल्यूशन समस्याओं को ठीक करें।",
  "bootArgGfxfw2": "उपयोग और प्रदर्शन को बेहतर बनाने के लिए पूर्ण iGPU फ़र्मवेयर लोडिंग सक्षम करें। बूट विफलता का कारण हो सकता है - सावधानी के साथ उपयोग करें।",
  "bootArgCdclk": "कोर डिस्प्ले क्लॉक (सीडीसीएलके) आवृत्ति बहुत कम होने के कारण 10वीं पीढ़ी के आइस लेक पर कर्नेल पैनिक को ठीक करें।",
  "bootArgIgfxdbeo": "10वीं पीढ़ी के आइस लेक पर कर्नेल पैनिक को ठीक करें जहां ड्राइवर DVMT पूर्व-आवंटित मेमोरी आकार की गलत गणना करता है।",
  "bootArgIceLakeDisplay": "10वीं पीढ़ी के आइस लेक लैपटॉप पर बूट के समय 7-15 सेकंड तक चलने वाले डिस्प्ले भ्रष्टाचार को ठीक करें।",
  "bootArgIgfxNoTelemetry": "बूट के दौरान iGPU टेलीमेट्री मॉड्यूल लोडिंग अक्षम करें। इस मॉड्यूल के लोड होने पर कुछ लैपटॉप (विशेषकर Chromebook) बूट पर रुक सकते हैं।",
  "bootArgWegNoEgpu": "असतत GPU को अक्षम करें (अनुशंसित जब Intel डुअल-GPU लैपटॉप पर dGPU - आमतौर पर NVIDIA - संचालित नहीं किया जा सकता है)।",
  "bootArgNvDisable": "NVIDIA ड्राइवर को अक्षम करें (केवल असंगत NVIDIA GPU को डीबग करने के लिए)।",
  "bootArgUnfairGva": "AMD GPU पर हार्डवेयर DRM समर्थन ठीक करें (समर्थित AMD GPU पर स्ट्रीमिंग जैसी DRM-संरक्षित सामग्री सक्षम करता है)।",
  "bootArgRadpg15": "पुराने AMD GPU (HD7750, HD7850 के साथ GCN कोर जैसे HD77XX/HD78XX/HD79XX) पर डिस्प्ले करप्शन (स्क्रैम्बल/पीली स्क्रीन) को ठीक करें।",
  "bootArgAmdNoAccel": "एटीआई/एएमडी जीपीयू त्वरण अक्षम करें (जब ओसीएलपी जीपीयू पैच, डीबग के बाद सिस्टम शुरू नहीं होगा तब उपयोग करें)।",
  "bootArgRaddvi": "पुराने AMD GPU (290X, 370, आदि) पर DVI आउटपुट डिस्प्ले ठीक करें।",
  "bootArgRadcodec": "आधिकारिक तौर पर असमर्थित एएमडी जीपीयू (उदाहरण के लिए, आरएक्स550 लेक्सा कोर) के लिए वीडीए हार्डवेयर वीडियो एन्कोडिंग समर्थन को ठीक करें।",
  "bootArgNgfxFermi": "MacOS बिग सुर 11+ पर पुराने NVIDIA फर्मी/मैक्सवेल/पास्कल कार्ड (GT610, GTX750, GTX960, GTX1050) के लिए GPU ड्राइवर समस्याओं को ठीक करें। सिस्टम में प्रवेश करने के बाद OCLP GPU पैच अवश्य लगाएं! केप्लर को इसकी आवश्यकता नहीं है।",
  "bootArgApplbkl3": "AMD Radeon RX 5000 श्रृंखला GPU के लिए PWM बैकलाइट नियंत्रण सक्षम करें।",
  "bootArgAgdpmodIgnore": "AppleGraphicsDevicePolicy.kext प्रतिबंधों को पूरी तरह से अनदेखा करके कुछ GPU पर काली स्क्रीन या डिस्प्ले समस्याओं को ठीक करें। EveryGreen.kext के साथ प्रयोग करें।",
  "bootArgAgdpmodPikera": "AMD Navi RX5XXX/RX6XXX GPU (RX5500, RX5600, RX5700, RX6600, RX6800, RX6900, आदि) के लिए बोर्ड-आईडी को बोर्ड-ix से बदलकर काली स्क्रीन को बूट पर ठीक करें। EveryGreen.kext के साथ प्रयोग करें।",
  "bootArgAgdpmodVit9696": "AppleGraphicsDevicePolicy में बोर्ड-आईडी चेक को अक्षम करके RX470/RX570 GPU पर सोने/जागने के बाद काली स्क्रीन को ठीक करें। EveryGreen.kext के साथ प्रयोग करें।",
  "bootArgAmdNoDgpuAccel": "Intel 3rd Gen या इससे पुराने AMD RX5XX/RX5XXX/RX6XXX के लिए मूल रूप से समर्थित GPU के लिए वेंचुरा+ पर काली स्क्रीन को ठीक करें। बूटिंग के बाद OCLP GPU पैच लागू करें, फिर इस तर्क को हटा दें।",
  "bootArgBrcmfx": "देश कोड को HK में बदलकर कुछ ब्रॉडकॉम वाई-फाई कार्ड पर धीमी गति को ठीक करें। आप राउटर चैनल को बदलकर भी सुधार कर सकते हैं।",
  "bootArgVsmcgen": "रैमरोड कोड हैंग और एसएमसी एमुलेटर भ्रष्टाचार की समस्याओं को ठीक करें।",
  "bootArgSwdPanic": "कर्नेल क्रैश लॉग एकत्र करने और स्लीप समस्याओं को डीबग करने में सहायता के लिए स्लीप के बाद डिवाइस को पुनरारंभ होने से रोकें।",
  "bootArgCtrsmt": "इंटेल 12वीं पीढ़ी+ हाइब्रिड (पी+ई) सीपीयू के लिए टोपोलॉजी पहचान और शेड्यूलिंग में सुधार करें। प्रदर्शन लाभ की गारंटी नहीं - सक्षम करने से पहले परीक्षण करें। CpuTopologyRebuild.kext की आवश्यकता है।",
  "bootArgDarkwake0": "डार्कवेक मोड को पूरी तरह से अक्षम करें और पारंपरिक स्लीप मोड का उपयोग करें। मुख्य रूप से वेक ब्लैक स्क्रीन और स्वचालित वेक समस्याओं को ठीक करता है।",
  "bootArgForceRenderStandby": "नींद के दौरान iGPU RC6 के कारण होने वाली NVMe कर्नेल घबराहट को ठीक करने के लिए iGPU RC6 रेंडर स्टैंडबाय को अक्षम करें।",
  "bootArgI2cForcePolling": "I2C ट्रैकपैड को इंटरप्ट-संचालित मोड के बजाय पोलिंग मोड का उपयोग करने के लिए बाध्य करें (इंटरप्ट मोड को आमतौर पर SSDT अनुकूलन की आवश्यकता होती है)।",
  "kextLiluDesc": "macOS के लिए विस्तारशीलता और अनुकूलता प्रदान करने वाला आवश्यक बेस ड्राइवर। सभी प्लगइन-प्रकार केक्स्ट इस पर निर्भर करते हैं।",
  "kextVirtualSMCDesc": "आवश्यक एसएमसी एमुलेटर। गैर-एप्पल हार्डवेयर पर Apple SMC का अनुकरण करता है, सेंसर, पंखा नियंत्रण और पावर प्रबंधन प्रदान करता है। इसके बिना macOS नहीं चल सकता।",
  "kextWhateverGreenDesc": "GPU ग्राफ़िक्स ड्राइवर समर्थन. अधिकांश उपयोगकर्ताओं के लिए पुरजोर अनुशंसा की जाती है। AMD dGPUs (RX460, RX560+) के साथ MacPro7,1 अनचेक हो सकता है। आमतौर पर NootRX/NootedRed के साथ टकराव होता है - इंस्टॉलेशन के दौरान एक साथ चयन न करें।",
  "kextAppleALCDesc": "अंतर्निहित ऑडियो कोडेक को खराब करने के लिए AppleALC का उपयोग करें (अधिक संपूर्ण समाधान, पसंदीदा विकल्प)।",
  "kextVoodooHDADesc": "यूनिवर्सल ऑडियो ड्राइवर वूडूएचडीए (बूट के दौरान लोड किया गया, केवल मैकओएस बिग सुर 11.2.3 और उससे नीचे का समर्थन करता है; उच्च संस्करणों को सिस्टम कर्नेल एक्सटेंशन फ़ोल्डर में इंजेक्ट करने की आवश्यकता होती है)।",
  "kextUSBInjectAllDesc": "जेनेरिक यूएसबी इंजेक्शन समाधान, यूएसबी अनुकूलन नहीं होने पर डिफ़ॉल्ट विकल्प।",
  "kextUSBToolBoxDesc": "USBToolBox समाधान, आमतौर पर अनुकूलित UTBMap.kext के साथ उपयोग किया जाता है।",
  "kextBatteryV1Desc": "बैटरी ड्राइवर समाधान 1 (तीसरी पीढ़ी के इंटेल या पुराने प्लेटफॉर्म वाले लैपटॉप के लिए)।",
  "kextBatteryV2Desc": "बैटरी ड्राइवर समाधान 2 (तीसरी पीढ़ी के इंटेल या नए प्लेटफॉर्म वाले लैपटॉप के लिए)।",
  "kextAmbientLightDesc": "परिवेश प्रकाश सेंसर (स्वचालित स्क्रीन चमक)। यदि आपके पास कोई परिवेश प्रकाश सेंसर नहीं है तो इसका उपयोग न करें, क्योंकि इससे समस्याएँ हो सकती हैं।",
  "kextAsusNBFnKeysDesc": "ASUS लैपटॉप प्रशंसक नियंत्रण, पावर प्रबंधन और अन्य सिस्टम सेंसर अनुकूलन। गैर-ASUS मशीनों के लिए अनुशंसित नहीं।",
  "kextLenovoDesc": "लेनोवो लैपटॉप प्रशंसक नियंत्रण, पावर प्रबंधन और अन्य सिस्टम सेंसर अनुकूलन। गैर-लेनोवो मशीनों के लिए अनुशंसित नहीं।",
  "kextDellDesc": "अधिक सटीक प्रशंसक निगरानी और नियंत्रण के लिए डेल लैपटॉप समर्पित सेंसर। गैर-डेल मशीनों के लिए अनुशंसित नहीं।",
  "kextNootRXDesc": "आधिकारिक तौर पर असमर्थित RX6XXX dGPUs (RX6700, RX6750XT, RX6750GRE, आदि) का समर्थन करें। व्हेयरग्रीन के साथ विरोध - स्थापना के दौरान एक साथ चयन न करें।",
  "kextBatteryFixDesc": "बैटरी रीडिंग फिक्स, कुछ बैटरी डिस्प्ले समस्याओं को ठीक करता है।",
  "kextNVMeFixDesc": "गैर-Apple NVMe SSDs के लिए अनुकूलता में सुधार करें और निष्क्रिय बिजली की खपत को कम करें। असंगत NVMe ड्राइव अभी भी क्रैश हो सकती हैं। संगत NVMe ड्राइव इस ड्राइवर के साथ कर्नेल पैनिक हो सकती है - सावधानी के साथ उपयोग करें।",
  "kextFeatureUnlockDesc": "असमर्थित मैक मॉडल पर यूनिवर्सल कंट्रोल, साइडकार और अन्य सुविधाओं को अनलॉक करें।",
  "kextHibernationFixDesc": "सामान्य हाइबरनेशन और नींद से संबंधित समस्याओं को ठीक करें।",
  "kextHoRNDIS": "MacOS को USB के माध्यम से Android डिवाइस नेटवर्क टेदरिंग का उपयोग करने की अनुमति दें।",
  "kextCPUFriendDesc": "सीपीयू फ़्रीक्वेंसी स्केलिंग ड्राइवर, मुख्य रूप से 11वीं पीढ़ी और नए प्लेटफ़ॉर्म पर MacPro7,1 के लिए फ़्रीक्वेंसी स्केलिंग समर्थन प्रदान करता है।",
  "kextCPUFriendDataProviderDesc": "सीपीयूफ्रेंड साथी डेटा ड्राइवर, विशिष्ट मशीन मॉडल के लिए सीपीयू आवृत्ति स्केलिंग डेटा प्रदान करता है।",
  "kextAppleIGHDA": "कुछ सिस्टम पर Intel iGPU HDMI ऑडियो समस्याओं को ठीक करें।",
  "kextNoTouchID": "Apple ID और iCloud में लॉग इन करने में असमर्थता को ठीक करें, आमतौर पर बिना स्थानीय वायर्ड नेटवर्क कार्ड वाले लैपटॉप के लिए।",
  "kextAppleRTCDesc": "नए प्लेटफ़ॉर्म पर macOS AppleRTC और PC BIOS के बीच टकराव को ठीक करें, उदाहरण के लिए, RTC के कारण हैंग होना, अचानक पुनरारंभ होना, या नींद से तुरंत जागना।",
  "kextPS2KBMouseDesc": "PS/2 कीबोर्ड और माउस ड्राइवर (PS/2 राउंड पोर्ट वाले डेस्कटॉप मदरबोर्ड के लिए)।",
  "kextPS2KeyboardDesc": "PS/2 कीबोर्ड ड्राइवर (PS/2 राउंड कीबोर्ड पोर्ट वाले डेस्कटॉप मदरबोर्ड के लिए)।",
  "kextPS2MouseDesc": "PS/2 माउस ड्राइवर (PS/2 राउंड माउस पोर्ट वाले डेस्कटॉप मदरबोर्ड के लिए)।",
  "kextMicrosoftSurfaceDesc": "Microsoft Surface समर्पित कीबोर्ड और ट्रैकपैड ड्राइवर।",
  "kextBrightnessKeysDesc": "चमक शॉर्टकट कुंजी ठीक करें।",
  "kextGenericUSBXHCIDesc": "पुराने या AMD प्लेटफ़ॉर्म के लिए USB 3.0 नियंत्रक संगतता समाधान।",
  "kextXLNCUSBFixDesc": "पुराने AMD प्लेटफ़ॉर्म (FM1/FM2/AM3) पर USB नियंत्रक संगतता समस्याओं को ठीक करें।",
  "kextRealtekCardReaderDesc": "रीयलटेक एसडी कार्ड रीडर ड्राइवर (RealtekCardReaderFriend के साथ प्रयोग करें)।",
  "kextRadeonSensorDesc": "AMD Radeon GPU प्रदर्शन को अनुकूलित करें, लेकिन कुछ परिदृश्यों में सिस्टम क्रैश या बूट विफलता हो सकती है - सावधानी के साथ उपयोग करें।",
